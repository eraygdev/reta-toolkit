#!/usr/bin/env bash
# reta — personal dev toolkit dispatcher
set -euo pipefail
shopt -s nullglob

RETA_ROOT="$HOME/.reta"
RETA_LIBEXEC="$RETA_ROOT/libexec"

# shellcheck source=../lib/ui.sh
source "$HOME/.reta/lib/ui.sh"

version="$(cat "$RETA_ROOT/VERSION" 2>/dev/null || echo "unknown")"

cmd="${1:-help}"
shift || true

# `reta help <cmd>` → delegate to `reta <cmd> --help`
if [ "$cmd" = "help" ] && [ $# -gt 0 ] && [ -n "${1:-}" ]; then
    sub="$RETA_LIBEXEC/reta-$1"
    if [ -x "$sub" ]; then
        exec "$sub" --help
    fi
    echo "reta: unknown command '$1'"
    echo "Try: reta help"
    exit 1
fi

case "$cmd" in
    help|--help|-h|"")
        printf "\n"
        printf "  ${MAGENTA}${BOLD}reta${RESET} ${DIM}v%s${RESET} — personal dev toolkit\n" "$version"
        printf "  ${DIM}────────────────────────────────────────${RESET}\n"
        printf "\n"
        printf "  ${DIM}Usage:${RESET} ${BOLD}reta${RESET} <command> [args...]\n"
        printf "         ${BOLD}reta${RESET} --version\n"

        if [ -d "$RETA_LIBEXEC" ]; then
            # First pass: collect unique group names in order of appearance
            groups=()
            for f in "$RETA_LIBEXEC"/reta-*; do
                [ -x "$f" ] || continue
                g="$(sed -n '3s/^# group: //p' "$f")"
                [ -z "$g" ] && g="Commands"
                found=0
                for existing in "${groups[@]:-}"; do
                    [ "$existing" = "$g" ] && found=1 && break
                done
                [ $found -eq 0 ] && groups+=("$g")
            done

            # Second pass: print each group with its commands sorted by order, then name
            for g in "${groups[@]}"; do
                printf "\n"
                printf "  ${YELLOW}%s${RESET}\n" "$g"
                entries=()
                for f in "$RETA_LIBEXEC"/reta-*; do
                    [ -x "$f" ] || continue
                    fg="$(sed -n '3s/^# group: //p' "$f")"
                    [ -z "$fg" ] && fg="Commands"
                    [ "$fg" != "$g" ] && continue
                    name="$(basename "$f")"
                    name="${name#reta-}"
                    desc="$(sed -n '2s/^# //p' "$f")"
                    [ -z "$desc" ] && desc="(no description)"
                    order="$(sed -n '1,10s/^# order: //p' "$f" | head -1)"
                    [[ "$order" =~ ^[0-9]+$ ]] || order=500
                    entries+=("${order}|${name}|${desc}")
                done
                while IFS='|' read -r _ name desc; do
                    [ -z "$name" ] && continue
                    printf "  ${CYAN}%-15s${RESET} %s\n" "$name" "$desc"
                done < <(printf '%s\n' "${entries[@]}" | LC_ALL=C sort -t'|' -k1,1n -k2,2)
            done

            [ ${#groups[@]} -eq 0 ] && printf "\n  ${DIM}(no commands installed)${RESET}\n"
        else
            printf "\n  ${DIM}(libexec/ not found — run install.sh)${RESET}\n"
        fi

        printf "\n"
        printf "  ${DIM}Run 'reta <command>' to execute.${RESET}\n"
        printf "\n"
        exit 0
        ;;
    --version|-v)
        echo "$version"
        exit 0
        ;;
esac

sub="$RETA_LIBEXEC/reta-$cmd"
if [ -x "$sub" ]; then
    exec "$sub" "$@"
fi

echo "reta: unknown command '$cmd'"
echo "Try: reta help"
exit 1