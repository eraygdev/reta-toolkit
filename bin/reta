#!/usr/bin/env bash
# reta — personal dev toolkit dispatcher
set -euo pipefail
shopt -s nullglob

RETA_ROOT="$HOME/.reta"
RETA_LIBEXEC="$RETA_ROOT/libexec"

BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
YELLOW='\033[1;33m'
MAGENTA='\033[1;35m'
RESET='\033[0m'

version="$(cat "$RETA_ROOT/VERSION" 2>/dev/null || echo "unknown")"

cmd="${1:-help}"
shift || true

case "$cmd" in
    help|--help|-h|"")
        printf "\n"
        printf "  ${MAGENTA}${BOLD}reta${RESET} ${DIM}v%s${RESET} — personal dev toolkit\n" "$version"
        printf "  ${DIM}────────────────────────────────────────${RESET}\n"
        printf "\n"
        printf "  ${DIM}Usage:${RESET} ${BOLD}reta${RESET} <command> [args...]\n"

        if [ -d "$RETA_LIBEXEC" ]; then
            # First pass: collect unique group names in order of appearance
            groups=()
            for f in "$RETA_LIBEXEC"/reta-*; do
                [ -x "$f" ] || continue
                g="$(sed -n '3s/^# group: //p' "$f")"
                [ -z "$g" ] && g="Commands"
                found=0
                for existing in "${groups[@]:-}"; do
                    [ "$existing" = "$g" ] && found=1 && break
                done
                [ $found -eq 0 ] && groups+=("$g")
            done

            # Second pass: print each group with its commands
            for g in "${groups[@]}"; do
                printf "\n"
                printf "  ${YELLOW}%s${RESET}\n" "$g"
                for f in "$RETA_LIBEXEC"/reta-*; do
                    [ -x "$f" ] || continue
                    fg="$(sed -n '3s/^# group: //p' "$f")"
                    [ -z "$fg" ] && fg="Commands"
                    [ "$fg" != "$g" ] && continue
                    name="$(basename "$f")"
                    name="${name#reta-}"
                    desc="$(sed -n '2s/^# //p' "$f")"
                    [ -z "$desc" ] && desc="(no description)"
                    printf "  ${CYAN}%-15s${RESET} %s\n" "$name" "$desc"
                done
            done

            [ ${#groups[@]} -eq 0 ] && printf "\n  ${DIM}(no commands installed)${RESET}\n"
        else
            printf "\n  ${DIM}(libexec/ not found — run install.sh)${RESET}\n"
        fi

        printf "\n"
        printf "  ${DIM}Run 'reta <command>' to execute.${RESET}\n"
        printf "\n"
        exit 0
        ;;
    --version|-v)
        echo "$version"
        exit 0
        ;;
esac

sub="$RETA_LIBEXEC/reta-$cmd"
if [ -x "$sub" ]; then
    exec "$sub" "$@"
fi

echo "reta: unknown command '$cmd'"
echo "Try: reta help"
exit 1