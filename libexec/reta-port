#!/usr/bin/env bash
# List listening ports, or kill a process on a specific port.
# group: Utilities
set -euo pipefail

# shellcheck source=../lib/ui.sh
source "$HOME/.reta/lib/ui.sh"

require_lsof() {
    if ! command -v ss >/dev/null 2>&1 && ! command -v lsof >/dev/null 2>&1; then
        ui_err "Neither ss nor lsof is available."
        echo "  Ubuntu/Debian: sudo apt install iproute2 lsof" >&2
        echo "  macOS:         preinstalled" >&2
        exit 1
    fi
}

usage() {
    echo "reta port — list or kill listening ports"
    echo ""
    echo "Usage: reta port <command> [args]"
    echo ""
    echo "Commands:"
    echo "  list              List all listening ports (grouped)"
    echo "  list <PORT>       Show only the process on PORT"
    echo "  kill              Interactive selector (pick from a menu)"
    echo "  kill <PORT>       Kill whatever listens on PORT"
    echo ""
    echo "Port classes:"
    echo "  [SYSTEM]  Privileged (<1024) or known service ports (22, 53, 443, ...)"
    echo "  [DOCKER]  Handled by a docker container"
    echo "  [USER]    Regular user processes"
    exit 0
}

KNOWN_SYSTEM_PORTS="22 53 80 123 443 631 3306 5432 6379 27017 11211"

service_name_for() {
    local port="$1"
    # Well-known names first (more intuitive than /etc/services)
    case "$port" in
        22)    echo "ssh";       return ;;
        53)    echo "dns";       return ;;
        80)    echo "http";      return ;;
        123)   echo "ntp";       return ;;
        443)   echo "https";     return ;;
        631)   echo "cups";      return ;;
        3306)  echo "mysql";     return ;;
        5432)  echo "postgres";  return ;;
        6379)  echo "redis";     return ;;
        27017) echo "mongodb";   return ;;
        11211) echo "memcached"; return ;;
    esac
    # Fall back to /etc/services for less common ports
    local out
    out=$(getent services "$port" 2>/dev/null | head -1)
    if [ -n "$out" ]; then
        echo "$out" | awk '{print $1}'
        return
    fi
    if [ -f /etc/services ]; then
        awk -v p="$port" '!/^#/ && ($2 == p"/tcp" || $2 == p"/udp") { print $1; exit }' /etc/services 2>/dev/null
    fi
}

port_class() {
    local port="$1"
    local pid="$2"
    if [ "$pid" = "docker" ]; then
        echo "docker"
        return
    fi
    local p
    for p in $KNOWN_SYSTEM_PORTS; do
        [ "$port" = "$p" ] && echo "system" && return
    done
    if [[ "$port" =~ ^[0-9]+$ ]] && [ "$port" -lt 1024 ]; then
        echo "system"
    else
        echo "user"
    fi
}

collect_ports() {
    local -A docker_map=()
    local -A seen=()

    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        while IFS='|' read -r name port_str; do
            [ -z "$port_str" ] && continue
            while IFS= read -r mapping; do
                mapping=$(echo "$mapping" | xargs 2>/dev/null)
                if [[ "$mapping" =~ ^[^:]+:([0-9]+)-\> ]]; then
                    docker_map["${BASH_REMATCH[1]}"]="$name"
                fi
            done < <(echo "$port_str" | tr ',' '\n')
        done < <(docker ps --format '{{.Names}}|{{.Ports}}' 2>/dev/null)
    fi

    if command -v ss >/dev/null 2>&1; then
        while IFS= read -r line; do
            local addr port proc pid
            addr=$(echo "$line" | awk '{print $5}')
            port=$(echo "$addr" | awk -F: '{print $NF}')
            [ -z "$port" ] && continue
            [ -n "${seen[$port]:-}" ] && continue
            seen[$port]=1

            if [ -n "${docker_map[$port]:-}" ]; then
                printf "%-6s %-20s %-8s %s\n" "$port" "${docker_map[$port]}" "docker" "$addr"
                continue
            fi

            proc=""
            pid=""
            if [[ "$line" == *"users:"* ]]; then
                proc=$(echo "$line" | sed -n 's/.*users:(("\([^"]*\)".*/\1/p' | head -1)
                pid=$(echo "$line" | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1)
            fi

            if [ -z "$proc" ]; then
                proc=$(service_name_for "$port")
                [ -z "$proc" ] && proc="-"
            fi
            [ -z "$pid" ] && pid="-"

            printf "%-6s %-20s %-8s %s\n" "$port" "$proc" "$pid" "$addr"
        done < <(ss -tulpn 2>/dev/null | awk 'NR>1 && /LISTEN/')
        return
    fi

    if command -v lsof >/dev/null 2>&1; then
        lsof -i -P -n 2>/dev/null | awk 'NR>1 && /LISTEN/ {
            port = ""
            for (i = 1; i <= NF; i++) {
                if ($i ~ /:[0-9]+$/) {
                    n = split($i, a, ":")
                    port = a[n]
                }
            }
            if (port != "") printf "%-6s %-20s %-8s %s\n", port, $1, $2, $9
        }'
    fi
}

_print_group() {
    local label="$1"
    local body="$2"
    [ -z "$body" ] && return
    printf "\n  %s%s%s\n" "$BOLD" "$label" "$RESET"
    printf "%s" "$body" | sed 's/^/    /'
}

cmd_list() {
    require_lsof
    local filter="${1:-}"
    local raw
    raw=$(collect_ports)

    if [ -z "$raw" ]; then
        ui_dim "No listening ports found."
        return 0
    fi

    local output="$raw"
    if [ -n "$filter" ]; then
        output=$(printf "%s\n" "$raw" | awk -v p="$filter" '$1 == p')
        if [ -z "$output" ]; then
            ui_dim "No process listening on port $filter."
            return 0
        fi
    fi

    local system_lines="" docker_lines="" user_lines=""
    local line port pid cls
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        port=$(echo "$line" | awk '{print $1}')
        pid=$(echo "$line" | awk '{print $3}')
        cls=$(port_class "$port" "$pid")
        case "$cls" in
            system) system_lines+="$line"$'\n' ;;
            docker) docker_lines+="$line"$'\n' ;;
            *)      user_lines+="$line"$'\n' ;;
        esac
    done <<< "$output"

    printf "  %s%-6s %-20s %-8s %s%s\n" "$BOLD" "PORT" "COMMAND" "PID" "ADDRESS" "$RESET"
    _print_group "SYSTEM" "$system_lines"
    _print_group "DOCKER" "$docker_lines"
    _print_group "USER"   "$user_lines"
}

_confirm_risky_ports() {
    local -a risky=()
    local entry
    for entry in "$@"; do
        local p="${entry%%:*}"
        local cls="${entry##*:}"
        if [ "$cls" = "system" ]; then
            risky+=("$p")
        fi
    done
    [ ${#risky[@]} -eq 0 ] && return 0
    echo ""
    ui_warn "You are about to stop system service port(s): ${risky[*]}"
    echo "         This can break networking, printing, databases, or other"
    echo "         system services. Proceed with extreme caution."
    echo ""
    read -rp "Really continue? [y/N] " ans
    case "$ans" in
        [yY]|[yY][eE][sS]) return 0 ;;
        *) ui_dim "Cancelled."; return 1 ;;
    esac
}

_kill_pids() {
    local label="$1"
    local pids="$2"

    echo ""
    echo "Target: $label"
    echo "PIDs:   $(echo "$pids" | tr '\n' ' ')"
    echo ""
    read -rp "Kill these processes? [y/N] " ans
    case "$ans" in
        [yY]|[yY][eE][sS]) ;;
        *) ui_dim "Cancelled."; return 0 ;;
    esac

    local killed=0 pid
    while IFS= read -r pid; do
        [ -z "$pid" ] && continue
        if kill -15 "$pid" 2>/dev/null; then
            killed=$((killed+1))
        fi
    done <<< "$pids"

    sleep 1

    while IFS= read -r pid; do
        [ -z "$pid" ] && continue
        if kill -0 "$pid" 2>/dev/null; then
            ui_warn "PID $pid did not exit, sending SIGKILL..."
            kill -9 "$pid" 2>/dev/null || true
        fi
    done <<< "$pids"

    ui_ok "Killed $killed process(es)."
}

cmd_kill_by_port() {
    local port="$1"

    if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        local container
        container=$(docker ps --format '{{.Names}}|{{.Ports}}' 2>/dev/null | \
            awk -F'|' -v p="$port" '
                $2 ~ (":" p "->") { print $1; exit }
            ')
        if [ -n "$container" ]; then
            echo ""
            echo "Port $port is handled by Docker container: $container"
            read -rp "Stop this container? [y/N] " ans
            case "$ans" in
                [yY]|[yY][eE][sS]) ;;
                *) ui_dim "Cancelled."; return 0 ;;
            esac
            if docker stop "$container" >/dev/null 2>&1; then
                ui_ok "stopped container $container (port $port released)"
            else
                ui_err "failed to stop container $container"
                return 1
            fi
            return 0
        fi
    fi

    local pids
    pids=$(lsof -i ":$port" -s TCP:LISTEN -t 2>/dev/null || true)
    if [ -z "$pids" ]; then
        pids=$(sudo -n lsof -i ":$port" -s TCP:LISTEN -t 2>/dev/null || true)
    fi
    if [ -z "$pids" ]; then
        ui_dim "No process listening on port $port (or you need sudo)."
        return 0
    fi

    local cls
    cls=$(port_class "$port" "-")
    if [ "$cls" = "system" ]; then
        echo ""
        ui_warn "Port $port is a system service port."
        echo "         Stopping it can break networking, printing, or other"
        echo "         system services."
        echo ""
        read -rp "Really continue? [y/N] " ans
        case "$ans" in
            [yY]|[yY][eE][sS]) ;;
            *) ui_dim "Cancelled."; return 0 ;;
        esac
    fi

    _kill_pids "port $port" "$pids"
}

cmd_kill_interactive() {
    local raw
    raw=$(collect_ports)
    if [ -z "$raw" ]; then
        ui_dim "No listening ports found."
        return 0
    fi

    # Reorder: SYSTEM first, DOCKER second, USER third
    local -a sys_lines=() dkr_lines=() usr_lines=()
    local line port pid cls
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        port=$(echo "$line" | awk '{print $1}')
        pid=$(echo "$line" | awk '{print $3}')
        cls=$(port_class "$port" "$pid")
        case "$cls" in
            system) sys_lines+=("$line") ;;
            docker) dkr_lines+=("$line") ;;
            *)      usr_lines+=("$line") ;;
        esac
    done <<< "$raw"

    local -a ordered=()
    [ ${#sys_lines[@]} -gt 0 ] && ordered+=("${sys_lines[@]}")
    [ ${#dkr_lines[@]} -gt 0 ] && ordered+=("${dkr_lines[@]}")
    [ ${#usr_lines[@]} -gt 0 ] && ordered+=("${usr_lines[@]}")

    local total=${#ordered[@]}

    echo "Listening ports:"
    echo ""
    local i=1
    for line in "${ordered[@]}"; do
        port=$(echo "$line" | awk '{print $1}')
        pid=$(echo "$line" | awk '{print $3}')
        cls=$(port_class "$port" "$pid")
        case "$cls" in
            system) tag="[SYSTEM]" ;;
            docker) tag="[DOCKER]" ;;
            *)      tag="[USER]  " ;;
        esac
        printf "  %2d) %s %s\n" "$i" "$tag" "$line"
        i=$((i+1))
    done
    echo ""

    local choice
    read -rp "Select (index/port, space or comma separated, q to quit): " choice
    if [ -z "$choice" ] || [ "$choice" = "q" ]; then
        return 0
    fi

    local -a tokens
    IFS=' ' read -ra tokens <<< "${choice//,/ }"

    local -a docker_names=()
    local -a pids=()
    local -a report=()
    local -a risky=()
    local tok selected_line pport pcmd ppid pcls

    for tok in "${tokens[@]}"; do
        [ -z "$tok" ] && continue
        selected_line=""
        if [[ "$tok" =~ ^[0-9]+$ ]] && [ "$tok" -ge 1 ] && [ "$tok" -le "$total" ]; then
            selected_line="${ordered[$((tok-1))]}"
        fi
        if [ -z "$selected_line" ]; then
            local l
            for l in "${ordered[@]}"; do
                if [ "$(echo "$l" | awk '{print $1}')" = "$tok" ]; then
                    selected_line="$l"
                    break
                fi
            done
        fi
        if [ -z "$selected_line" ]; then
            ui_warn "Not found: $tok"
            continue
        fi

        pport=$(echo "$selected_line" | awk '{print $1}')
        pcmd=$(echo "$selected_line" | awk '{print $2}')
        ppid=$(echo "$selected_line" | awk '{print $3}')
        pcls=$(port_class "$pport" "$ppid")

        if [ "$ppid" = "docker" ]; then
            docker_names+=("$pcmd")
            report+=("port $pport -> docker container $pcmd")
        elif [ -z "$ppid" ] || [ "$ppid" = "-" ]; then
            report+=("port $pport -> no PID visible (try: sudo reta port kill $pport)")
        else
            pids+=("$ppid")
            report+=("port $pport -> PID $ppid ($pcmd)")
        fi

        if [ "$pcls" = "system" ]; then
            risky+=("$pport:system")
        fi
    done

    if [ ${#docker_names[@]} -eq 0 ] && [ ${#pids[@]} -eq 0 ]; then
        ui_dim "Nothing to kill."
        return 0
    fi

    echo ""
    echo "Targets:"
    local r
    for r in "${report[@]}"; do
        echo "  - $r"
    done

    if [ ${#risky[@]} -gt 0 ]; then
        if ! _confirm_risky_ports "${risky[@]}"; then
            return 0
        fi
    else
        echo ""
        read -rp "Proceed? [y/N] " ans
        case "$ans" in
            [yY]|[yY][eE][sS]) ;;
            *) ui_dim "Cancelled."; return 0 ;;
        esac
    fi

    echo ""

    if [ ${#docker_names[@]} -gt 0 ]; then
        if docker stop "${docker_names[@]}" >/dev/null 2>&1; then
            ui_ok "stopped container(s): ${docker_names[*]}"
        else
            ui_err "failed to stop container(s): ${docker_names[*]}"
        fi
    fi

    if [ ${#pids[@]} -gt 0 ]; then
        local killed=0 pid
        for pid in "${pids[@]}"; do
            if kill -15 "$pid" 2>/dev/null; then
                killed=$((killed+1))
            fi
        done
        sleep 1
        for pid in "${pids[@]}"; do
            if kill -0 "$pid" 2>/dev/null; then
                ui_warn "PID $pid did not exit, sending SIGKILL..."
                kill -9 "$pid" 2>/dev/null || true
            fi
        done
        ui_ok "killed $killed process(es)"
    fi
}

cmd_kill() {
    require_lsof
    local target="${1:-}"
    if [ -n "$target" ]; then
        cmd_kill_by_port "$target"
    else
        cmd_kill_interactive
    fi
}

main() {
    local sub="${1:-}"
    [ $# -gt 0 ] && shift

    case "$sub" in
        list|ls)  cmd_list "$@" ;;
        kill)     cmd_kill "$@" ;;
        help|--help|-h|"") usage ;;
        *)
            ui_err "Unknown subcommand: $sub"
            echo "Run: reta port help"
            exit 1
            ;;
    esac
}

main "$@"