#!/usr/bin/env python3
# Generate .env from .env.example. Resolves GENERATE_SECRET and AUTO_HASH markers.
# group: Setup
# order: 20

from __future__ import annotations

import argparse
import getpass
import secrets
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from ui import BOLD, DIM, CYAN, GREEN, YELLOW, RED, RESET, next_steps  # noqa: E402


def generate_secret() -> str:
    """64-character hex string (32 random bytes)."""
    return secrets.token_hex(32)


def hash_password(password: str) -> str:
    """Return a bcrypt hash. Raises RuntimeError if bcrypt is not installed."""
    try:
        import bcrypt  # type: ignore
    except ImportError as exc:
        raise RuntimeError(
            "bcrypt is required for AUTO_HASH. Install it with: pip install bcrypt"
        ) from exc

    h = bcrypt.hashpw(password.encode(), bcrypt.gensalt())
    return h.decode()


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Generate .env from .env.example. Resolves special markers."
    )
    ap.add_argument(
        "-i",
        "--input",
        default=".env.example",
        help="Template file (default: .env.example)",
    )
    ap.add_argument(
        "-o", "--output", default=".env", help="Output file (default: .env)"
    )
    ap.add_argument(
        "-f", "--force", action="store_true", help="Overwrite output if it exists"
    )
    ap.add_argument(
        "-n", "--dry-run", action="store_true", help="Show result without writing"
    )
    args = ap.parse_args()

    src = Path(args.input)
    dst = Path(args.output)

    if not src.exists():
        print(f"{RED}Error:{RESET} {src} not found in {Path.cwd()}", file=sys.stderr)
        return 1

    if dst.exists() and not args.force:
        print(
            f"{RED}Error:{RESET} {dst} already exists. Use {BOLD}--force{RESET} to overwrite.",
            file=sys.stderr,
        )
        return 1

    print(f"{BOLD}reta init-env{RESET}")
    print(f"  source: {src}")
    print(f"  output: {dst}")
    print()

    output_lines: list[str] = []
    secret_count = 0
    hash_count = 0
    prompt_count = 0
    skip_count = 0

    for raw_line in src.read_text(encoding="utf-8").splitlines():
        stripped = raw_line.strip()

        # Blank lines and comments — pass through unchanged
        if not stripped or stripped.startswith("#"):
            output_lines.append(raw_line)
            continue

        # KEY=VALUE
        if "=" in raw_line:
            key, _, value = raw_line.partition("=")
            key = key.rstrip()
            val = value.strip()

            if val == "GENERATE_SECRET":
                new_val = generate_secret()
                output_lines.append(f"{key}={new_val}")
                secret_count += 1
                print(f"  {GREEN}generated{RESET} {CYAN}{key}{RESET}")

            elif val == "AUTO_HASH":
                pw = getpass.getpass(f"  password for {key}: ")
                if not pw:
                    print(f"  {YELLOW}skip{RESET} {key} (empty password)")
                    output_lines.append(f"{key}=")
                    skip_count += 1
                else:
                    try:
                        h = hash_password(pw)
                    except RuntimeError as exc:
                        print(f"{RED}Error:{RESET} {exc}", file=sys.stderr)
                        return 1
                    output_lines.append(f"{key}={h}")
                    hash_count += 1
                    print(f"  {GREEN}hashed{RESET} {CYAN}{key}{RESET}")

            elif val == "":
                user_val = input(f"  {key} {DIM}(press Enter to skip){RESET}: ").strip()
                output_lines.append(f"{key}={user_val}")
                prompt_count += 1
                if user_val:
                    print(f"  {GREEN}set{RESET} {CYAN}{key}{RESET}")
                else:
                    print(f"  {YELLOW}skip{RESET} {key}")

            else:
                output_lines.append(raw_line)

        else:
            output_lines.append(raw_line)

    result = "\n".join(output_lines) + "\n"

    if args.dry_run:
        print(f"\n{DIM}--- dry run, would write: ---{RESET}")
        print(result)
        print(f"{DIM}--- end ---{RESET}")
        return 0

    dst.write_text(result, encoding="utf-8")

    print()
    print(f"{GREEN}done{RESET} {dst}")
    print(
        f"  {secret_count} secret(s), {hash_count} hash(es), {prompt_count} prompt(s), {skip_count} skipped"
    )

    # Warn if .env will be committed
    gitignore = Path(".gitignore")
    if gitignore.exists():
        content = gitignore.read_text(encoding="utf-8")
        ignored = False
        for raw in content.splitlines():
            pattern = raw.strip()
            if not pattern or pattern.startswith("#"):
                continue
            if pattern in {
                ".env",
                "/.env",
                ".env*",
                "/.env*",
                "*.env",
                "**/.env",
                "**/.env*",
            }:
                ignored = True
                break
        if not ignored:
            print(
                f"\n{YELLOW}warn{RESET} .env is not in .gitignore — add it before committing!"
            )

    steps = ["reta env check     Verify all keys are filled"]
    steps.append("reta env list      Preview keys with masked values")
    if Path("Makefile").exists():
        steps.append("make help          List available make targets")
    next_steps(steps)

    return 0


if __name__ == "__main__":
    sys.exit(main())
