#!/usr/bin/env python3
# View and change persistent reta settings.
# group: Setup

from __future__ import annotations

import argparse
import sys
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "reta"
CONFIG_FILE = CONFIG_DIR / "config"
DEFAULTS = {"hints": "on"}
VALID_KEYS = set(DEFAULTS)
VALID_VALUES = ("on", "off")


def load_config() -> dict[str, str]:
    cfg = dict(DEFAULTS)
    if not CONFIG_FILE.exists():
        return cfg
    try:
        for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            key, value = key.strip(), value.strip()
            if key in VALID_KEYS:
                cfg[key] = value
    except OSError:
        pass
    return cfg


def save_config(cfg: dict[str, str]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    lines = ["# reta settings — managed by 'reta config'"]
    for key in sorted(cfg):
        lines.append(f"{key}={cfg[key]}")
    CONFIG_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")


def main() -> int:
    ap = argparse.ArgumentParser(
        description="View and change persistent reta settings.",
    )
    ap.add_argument("key", nargs="?", help="Setting name (e.g. hints)")
    ap.add_argument("value", nargs="?", choices=VALID_VALUES, help="on or off")
    ap.add_argument(
        "--reset", action="store_true", help="Reset all settings to defaults"
    )
    args = ap.parse_args()

    if args.reset:
        if CONFIG_FILE.exists():
            CONFIG_FILE.unlink()
            print(f"OK  reset {CONFIG_FILE}")
        else:
            print("OK  already at defaults")
        return 0

    cfg = load_config()

    if args.key is None:
        print("reta settings")
        print(f"  config: {CONFIG_FILE}")
        print("")
        for key in sorted(cfg):
            default = DEFAULTS[key]
            marker = "" if cfg[key] == default else " (custom)"
            print(f"  {key:<10} {cfg[key]}{marker}")
        print("")
        print("Change: reta config hints off")
        return 0

    if args.key not in VALID_KEYS:
        print(f"Error: unknown setting '{args.key}'.", file=sys.stderr)
        print(f"Valid: {', '.join(sorted(VALID_KEYS))}", file=sys.stderr)
        return 1

    if args.value is None:
        print(f"{args.key}={cfg[args.key]}")
        return 0

    cfg[args.key] = args.value
    save_config(cfg)
    print(f"OK  {args.key}={args.value}")
    if args.key == "hints" and args.value == "off":
        print("Next steps are now hidden in all commands.")
    elif args.key == "hints" and args.value == "on":
        print("Next steps are now shown in all commands.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
