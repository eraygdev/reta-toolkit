#!/usr/bin/env python3
# Inspect .env against .env.example: missing keys, masked values, key diff.
# group: Setup

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from ui import BOLD, DIM, CYAN, GREEN, YELLOW, RED, RESET, next_steps  # noqa: E402


def die_missing(path: Path, hints: list[str]) -> None:
    print(f"{RED}Error:{RESET} {path} not found.", file=sys.stderr)
    print("", file=sys.stderr)
    print("Next steps:", file=sys.stderr)
    for hint in hints:
        print(f"  {BOLD}{hint}{RESET}", file=sys.stderr)


def parse_env(path: Path) -> dict[str, str]:
    result, _ = parse_env_with_dupes(path)
    return result


def parse_env_with_dupes(path: Path) -> tuple[dict[str, str], list[str]]:
    result: dict[str, str] = {}
    duplicates: list[str] = []
    if not path.exists():
        return result, duplicates
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        if "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
            value = value[1:-1]
        if key in result and key not in duplicates:
            duplicates.append(key)
        result[key] = value
    return result, duplicates


def cmd_check(example: dict[str, str], env: dict[str, str]) -> int:
    missing = [k for k in example if k not in env]
    empty = [k for k in example if k in env and not env[k]]

    if not missing and not empty:
        print(
            f"{GREEN}OK{RESET} .env is in sync with .env.example ({len(example)} keys)"
        )
        return 0

    if missing:
        print(f"{RED}Missing{RESET} in .env ({len(missing)}):")
        for k in missing:
            print(f"  {CYAN}{k}{RESET}")

    if empty:
        if missing:
            print("")
        print(f"{YELLOW}Empty{RESET} values in .env ({len(empty)}):")
        for k in empty:
            print(f"  {CYAN}{k}{RESET}")

    print("")
    print(f"{DIM}Hint:{RESET} Fill these in .env, or ignore if not used.")
    return 1


def cmd_list(env: dict[str, str], show: bool) -> int:
    if not env:
        print("No keys found in .env")
        return 1
    width = max(len(k) for k in env)
    for k in sorted(env):
        v = env[k]
        if not v:
            masked = f"{DIM}(empty){RESET}"
        elif show:
            masked = v
        else:
            masked = "***" if len(v) > 3 else "*"
        print(f"  {CYAN}{k:<{width}}{RESET}  {masked}")
    return 0


def cmd_diff(example: dict[str, str], env: dict[str, str]) -> int:
    only_example = sorted(k for k in example if k not in env)
    only_env = sorted(k for k in env if k not in example)
    common = sorted(k for k in example if k in env)

    if not only_example and not only_env:
        print(
            f"{GREEN}OK{RESET} .env and .env.example have identical keys ({len(common)})"
        )
        return 0

    if only_example:
        print(f"{RED}Only in .env.example{RESET} ({len(only_example)}):")
        for k in only_example:
            print(f"  - {CYAN}{k}{RESET}")

    if only_env:
        if only_example:
            print("")
        print(f"{YELLOW}Only in .env{RESET} ({len(only_env)}):")
        for k in only_env:
            print(f"  + {CYAN}{k}{RESET}")

    return 1


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Inspect .env against .env.example.",
    )
    ap.add_argument("--env", default=".env", help="Env file (default: .env)")
    ap.add_argument(
        "--example", default=".env.example", help="Example file (default: .env.example)"
    )

    sub = ap.add_subparsers(dest="cmd", required=False)
    sub.add_parser("check", help="List keys missing from .env")
    p_list = sub.add_parser("list", help="List keys in .env with masked values")
    p_list.add_argument("--show", action="store_true", help="Show real values")
    sub.add_parser("diff", help="Compare keys between .env and .env.example")

    args = ap.parse_args()

    if not args.cmd:
        print(f"{BOLD}reta env{RESET} — inspect .env against .env.example")
        print("")
        print("Usage: reta env <command> [options]")
        print("")
        print("Commands:")
        print(f"  {CYAN}check{RESET}    List keys missing or empty in .env")
        print(f"  {CYAN}list{RESET}     List keys in .env with masked values")
        print(f"           Use {BOLD}--show{RESET} to reveal values")
        print(f"  {CYAN}diff{RESET}     Compare keys between .env and .env.example")
        print("")
        print("Options:")
        print(f"  {BOLD}--env{RESET}      Env file (default: .env)")
        print(f"  {BOLD}--example{RESET}  Example file (default: .env.example)")
        return 0

    env_path = Path(args.env)
    example_path = Path(args.example)

    # Hard stops before any parsing or output
    if not example_path.exists():
        die_missing(
            example_path,
            [
                "reta init        Scaffold .env.example in this directory",
                "reta init-env    Then generate .env from it",
            ],
        )
        return 1

    if not env_path.exists():
        die_missing(
            env_path,
            ["reta init-env    Generate .env from .env.example"],
        )
        return 1

    example, example_dupes = parse_env_with_dupes(example_path)
    env, env_dupes = parse_env_with_dupes(env_path)

    if env_dupes:
        print(
            f"{YELLOW}Warning:{RESET} duplicate keys in {env_path} "
            f"({len(env_dupes)}): {', '.join(env_dupes)}"
        )
        print(
            f"{DIM}Duplicate keys cause inconsistent behavior across tools "
            f"(docker, dotenv, bash). Keep only one definition per key.{RESET}"
        )
        print("")

    if example_dupes:
        print(
            f"{YELLOW}Warning:{RESET} duplicate keys in {example_path} "
            f"({len(example_dupes)}): {', '.join(example_dupes)}"
        )
        print("")

    print(f"{BOLD}reta env {args.cmd}{RESET}")
    print(f"  env:     {env_path}")
    print(f"  example: {example_path}")
    print("")

    if args.cmd == "check":
        code = cmd_check(example, env)
        if code == 0:
            next_steps(
                [
                    "reta env diff      Confirm .env.example keys match .env",
                    "reta env list      Preview values with masking",
                ]
            )
        else:
            next_steps(
                [
                    "edit .env          Fill in the missing/empty keys above",
                    "reta env check     Re-check after editing",
                ]
            )
        return 0
    if args.cmd == "list":
        code = cmd_list(env, args.show)
        if code == 0:
            next_steps(
                [
                    "reta env check     Verify all keys are set",
                    "reta env diff      Compare against .env.example",
                ]
            )
        return code
    if args.cmd == "diff":
        code = cmd_diff(example, env)
        if code == 0:
            next_steps(
                [
                    "reta env check     Ensure values are filled",
                    "reta env list      Preview current values",
                ]
            )
        else:
            next_steps(
                [
                    "sync .env with .env.example",
                    "reta env check     Re-verify after syncing",
                ]
            )
        return code

    return 1


if __name__ == "__main__":
    sys.exit(main())
