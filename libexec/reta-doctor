#!/usr/bin/env bash
# Check reta installation health.
# group: Diagnostics
set -uo pipefail
shopt -s nullglob

# shellcheck source=../lib/ui.sh
source "$HOME/.reta/lib/ui.sh"

RETA_ROOT="$HOME/.reta"
TARGET="$HOME/.local/bin"

ok=0
warn=0
fail=0

check_ok()   { ui_ok   "$1"; ok=$((ok+1)); }
check_warn() { ui_warn "$1"; warn=$((warn+1)); }
check_fail() { ui_fail "$1"; fail=$((fail+1)); }

echo "reta doctor"
echo ""

echo "Symlinks:"
if [ -L "$HOME/.reta" ] && [ -e "$HOME/.reta" ]; then
    check_ok "~/.reta -> $(readlink "$HOME/.reta")"
elif [ -d "$HOME/.reta" ]; then
    check_ok "~/.reta exists (direct install)"
else
    check_fail "~/.reta missing (run install.sh)"
fi

if [ -L "$TARGET/reta" ] && [ -x "$TARGET/reta" ]; then
    check_ok "~/.local/bin/reta -> $(readlink "$TARGET/reta")"
else
    check_fail "~/.local/bin/reta missing or not executable"
fi

echo ""
echo "Files:"
[ -f "$RETA_ROOT/VERSION" ] && check_ok "VERSION ($(cat "$RETA_ROOT/VERSION"))" || check_fail "VERSION missing"
[ -f "$RETA_ROOT/lib/base.mk" ] && check_ok "lib/base.mk" || check_fail "lib/base.mk missing"
[ -d "$RETA_ROOT/templates" ] && check_ok "templates/ directory" || check_fail "templates/ missing"
[ -x "$RETA_ROOT/lib/export-context" ] && check_ok "lib/export-context (executable)" || check_warn "lib/export-context not executable"
[ -x "$RETA_ROOT/lib/check-secrets" ] && check_ok "lib/check-secrets (executable)" || check_warn "lib/check-secrets not executable"
[ -x "$RETA_ROOT/lib/adopt-makefile" ] && check_ok "lib/adopt-makefile (executable)" || check_warn "lib/adopt-makefile not executable"
if [ -x "$RETA_ROOT/tests/run.sh" ]; then
    check_ok "tests/run.sh (executable)"
elif [ -f "$RETA_ROOT/tests/run.sh" ]; then
    check_warn "tests/run.sh not executable"
else
    check_warn "tests/run.sh missing"
fi

echo ""
echo "Subcommands:"
if [ -d "$RETA_ROOT/libexec" ]; then
    for f in "$RETA_ROOT/libexec"/reta-*; do
        name="$(basename "$f")"
        if [ -x "$f" ]; then
            check_ok "$name"
        else
            check_warn "$name (not executable)"
        fi
    done
else
    check_fail "libexec/ missing"
fi

echo ""
echo "Completion:"
BASH_COMP="$HOME/.local/share/bash-completion/completions/reta"
ZSH_COMP="$HOME/.zfunc/_reta"

if [ -e "$BASH_COMP" ]; then
    check_ok "bash completion ($BASH_COMP)"
else
    check_warn "bash completion not linked (run install.sh)"
fi

if command -v zsh >/dev/null 2>&1; then
    if [ -e "$ZSH_COMP" ]; then
        check_ok "zsh completion ($ZSH_COMP)"
    else
        check_warn "zsh completion not linked (run install.sh)"
    fi
    if [ -f "$HOME/.zshrc" ]; then
        if grep -qs "fpath.*\.zfunc" "$HOME/.zshrc" 2>/dev/null; then
            check_ok "zsh fpath configured in ~/.zshrc"
        else
            check_warn "zsh: fpath+=~/.zfunc missing in ~/.zshrc"
        fi
    fi
else
    ui_dim "zsh not installed (skipped)"
fi

echo ""
echo "Environment:"
case ":$PATH:" in
    *":$TARGET:"*) check_ok "$TARGET is on PATH" ;;
    *) check_fail "$TARGET is not on PATH" ;;
esac

command -v make >/dev/null 2>&1 && check_ok "make available" || check_fail "make not found (base.mk targets won't work)"

if command -v python3 >/dev/null 2>&1; then
    pyver="$(python3 --version 2>&1 | awk '{print $2}')"
    check_ok "python3 available ($pyver)"
    if python3 -c "import bcrypt" 2>/dev/null; then
        check_ok "python bcrypt available (reta init-env AUTO_HASH)"
    else
        check_warn "python bcrypt not installed (reta init-env AUTO_HASH won't work)"
    fi
else
    check_fail "python3 not found (reta env, reta init-env won't work)"
fi

command -v git    >/dev/null 2>&1 && check_ok "git available"    || check_warn "git not found (reta update won't work)"
command -v docker >/dev/null 2>&1 && check_ok "docker available" || check_warn "docker not found (make up/down won't work)"

if command -v ss >/dev/null 2>&1; then
    check_ok "ss available (reta port)"
elif command -v lsof >/dev/null 2>&1; then
    check_ok "lsof available (reta port)"
else
    check_fail "neither ss nor lsof found (reta port won't work)"
fi

echo ""
echo "Summary: $ok OK, $warn WARN, $fail FAIL"
[ $fail -eq 0 ] || exit 1