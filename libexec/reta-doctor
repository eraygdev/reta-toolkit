#!/usr/bin/env bash
# Check reta installation health.
# group: Diagnostics
set -uo pipefail
shopt -s nullglob

# shellcheck source=../lib/ui.sh
source "$HOME/.reta/lib/ui.sh"

RETA_ROOT="$HOME/.reta"
TARGET="$HOME/.local/bin"

ok=0
warn=0
fail=0

check_ok()   { ui_ok   "$1"; ok=$((ok+1)); }
check_warn() { ui_warn "$1"; warn=$((warn+1)); }
check_fail() { ui_fail "$1"; fail=$((fail+1)); }

echo "reta doctor"
echo ""

echo "Symlinks:"
if [ -L "$HOME/.reta" ] && [ -e "$HOME/.reta" ]; then
    check_ok "~/.reta -> $(readlink "$HOME/.reta")"
elif [ -d "$HOME/.reta" ]; then
    check_ok "~/.reta exists (direct install)"
else
    check_fail "~/.reta missing (run install.sh)"
fi

if [ -L "$TARGET/reta" ] && [ -x "$TARGET/reta" ]; then
    check_ok "~/.local/bin/reta -> $(readlink "$TARGET/reta")"
else
    check_fail "~/.local/bin/reta missing or not executable"
fi

echo ""
echo "Files:"
[ -f "$RETA_ROOT/VERSION" ] && check_ok "VERSION ($(cat "$RETA_ROOT/VERSION"))" || check_fail "VERSION missing"
[ -f "$RETA_ROOT/lib/base.mk" ] && check_ok "lib/base.mk" || check_fail "lib/base.mk missing"
[ -x "$RETA_ROOT/lib/export-context" ] && check_ok "lib/export-context (executable)" || check_warn "lib/export-context not executable"

echo ""
echo "Subcommands:"
if [ -d "$RETA_ROOT/libexec" ]; then
    for f in "$RETA_ROOT/libexec"/reta-*; do
        name="$(basename "$f")"
        if [ -x "$f" ]; then
            check_ok "$name"
        else
            check_warn "$name (not executable)"
        fi
    done
else
    check_fail "libexec/ missing"
fi

echo ""
echo "Environment:"
case ":$PATH:" in
    *":$TARGET:"*) check_ok "$TARGET is on PATH" ;;
    *) check_fail "$TARGET is not on PATH" ;;
esac

command -v docker >/dev/null 2>&1 && check_ok "docker available" || check_warn "docker not found (make up/down won't work)"
command -v git    >/dev/null 2>&1 && check_ok "git available"    || check_fail "git not found"

echo ""
echo "Summary: $ok OK, $warn WARN, $fail FAIL"
[ $fail -eq 0 ] || exit 1