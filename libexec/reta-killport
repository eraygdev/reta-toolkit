#!/usr/bin/env bash
# Interactive port killer. Lists listening ports, lets you pick one, and kills it.
# group: Utilities
set -euo pipefail

if ! command -v lsof >/dev/null 2>&1; then
    echo "Error: lsof is required but not installed." >&2
    echo "  Ubuntu/Debian: sudo apt install lsof" >&2
    echo "  macOS:         preinstalled" >&2
    exit 1
fi

raw=$(lsof -i -P -n 2>/dev/null | awk 'NR==1 || /LISTEN/')

if [ -z "$raw" ] || [ "$(printf "%s\n" "$raw" | wc -l)" -le 1 ]; then
    echo "No listening ports found."
    exit 0
fi

menu=$(printf "%s\n" "$raw" | awk 'NR>1 && /LISTEN/ {
    port = ""
    for (i = 1; i <= NF; i++) {
        if ($i ~ /:[0-9]+$/) {
            n = split($i, a, ":")
            port = a[n]
        }
    }
    if (port != "") printf "%-6s %-20s PID=%-7s %s\n", port, $1, $2, $9
}')

if [ -z "$menu" ]; then
    echo "No listening ports found."
    exit 0
fi

if command -v fzf >/dev/null 2>&1; then
    selected=$(printf "%s\n" "$menu" | fzf --prompt="Kill port> " --height=40% --reverse --header="PORT   COMMAND              PID")
else
    echo "Listening ports:"
    echo ""
    i=1
    while IFS= read -r line; do
        printf "  %2d) %s\n" "$i" "$line"
        i=$((i+1))
    done <<< "$menu"
    echo ""
    read -rp "Select port number (or q to quit): " choice
    if [ -z "$choice" ] || [ "$choice" = "q" ]; then
        exit 0
    fi
    if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
        echo "Invalid selection: $choice"
        exit 1
    fi
    selected=$(printf "%s\n" "$menu" | sed -n "${choice}p")
    if [ -z "$selected" ]; then
        echo "Invalid selection: $choice"
        exit 1
    fi
fi

port=$(printf "%s" "$selected" | awk '{print $1}')
pid=$(printf "%s" "$selected" | sed -n 's/.*PID=\([0-9]*\).*/\1/p')
cmd=$(printf "%s" "$selected" | awk '{print $2}')

if [ -z "$pid" ] || [ -z "$port" ]; then
    echo "Could not parse selection: $selected"
    exit 1
fi

echo ""
echo "Port:    $port"
echo "Command: $cmd"
echo "PID:     $pid"
echo ""
read -rp "Kill this process? [y/N] " ans
case "$ans" in
    [yY]|[yY][eE][sS]) ;;
    *) echo "Cancelled."; exit 0 ;;
esac

if ! kill -15 "$pid" 2>/dev/null; then
    echo "Failed to send SIGTERM to PID $pid (permission denied? try sudo)."
    exit 1
fi

sleep 1

if kill -0 "$pid" 2>/dev/null; then
    echo "Process $pid did not exit, sending SIGKILL..."
    kill -9 "$pid" 2>/dev/null || true
fi

echo "Killed process $pid (port $port released)."