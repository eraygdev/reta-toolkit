def human_size(n: float) -> str:
    for unit in ["B", "KB", "MB", "GB"]:
        if n < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def parse_size(s: str) -> int:
    s = s.strip().upper()
    if not s:
        return 0
    mult = {"K": 1024, "M": 1024**2, "G": 1024**3, "B": 1}
    if s[-1] in mult:
        return int(float(s[:-1]) * mult[s[-1]])
    return int(s)


def load_exportignore(root: Path) -> list[str]:
    path = root / ".exportignore"
    if not path.exists():
        return []
    return [
        line.strip()
        for line in path.read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]


def matches_ignore(rel_path: str, patterns: list[str]) -> bool:
    for pat in patterns:
        if pat.endswith("/"):
            if rel_path.startswith(pat.rstrip("/") + "/") or rel_path == pat.rstrip(
                "/"
            ):
                return True
        elif fnmatch.fnmatch(rel_path, pat):
            return True
        elif "/" not in pat and fnmatch.fnmatch(Path(rel_path).name, pat):
            return True
    return False


def should_skip_dir(name: str) -> bool:
    if name == ".github":
        return False
    return name in HIDDEN_DIRS or name in SUMMARY_DIRS or name.startswith(".")


def should_include_file(path: Path) -> bool:
    name = path.name
    suffix = path.suffix.lower()

    if name in EXCLUDE_NAMES or suffix in EXCLUDE_EXT:
        return False
    if name in INCLUDE_NAMES:
        return True
    if name.startswith(".env."):
        return name == ".env.example"
    if suffix in INCLUDE_EXT:
        return True
    # Extension-less scripts with shebang
    if not suffix:
        try:
            with path.open("rb") as f:
                return f.read(2) == b"#!"
        except Exception:
            return False
    return False


def is_excluded_file(path: Path) -> bool:
    return path.name in EXCLUDE_NAMES or path.suffix.lower() in EXCLUDE_EXT


def dir_total_size(path: Path) -> int:
    total = 0
    for cur, _, names in os.walk(path):
        for n in names:
            try:
                total += (Path(cur) / n).stat().st_size
            except OSError:
                pass
    return total


def collect_dir_summaries(
    root: Path, exportignore: list[str]
) -> list[tuple[Path, int]]:
    summaries: list[tuple[Path, int]] = []
    for cur, dirs, _ in os.walk(root):
        for d in dirs:
            if d not in SUMMARY_DIRS:
                continue
            p = Path(cur) / d
            rel = str(p.relative_to(root)).replace(os.sep, "/")
            if matches_ignore(rel + "/", exportignore):
                continue
            summaries.append((p, dir_total_size(p)))
        dirs[:] = [d for d in dirs if not should_skip_dir(d)]
    summaries.sort(key=lambda x: str(x[0]).lower())
    return summaries


def collect_skipped(
    root: Path, exportignore: list[str], skip_paths: set[Path]
) -> list[tuple[Path, int]]:
    skipped: list[tuple[Path, int]] = []
    for cur, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if not should_skip_dir(d)]
        for n in names:
            p = Path(cur) / n
            if p in skip_paths:
                continue
            rel = str(p.relative_to(root)).replace(os.sep, "/")
            if matches_ignore(rel, exportignore):
                continue
            if not is_excluded_file(p):
                continue
            try:
                size = p.stat().st_size
            except OSError:
                continue
            skipped.append((p, size))
    skipped.sort(key=lambda x: str(x[0]).lower())
    return skipped


def resolve_output_from_dir(root: Path, export_dir: str) -> Path:
    val = export_dir.strip() or "exports"
    if val == ".":
        return (root / "project_export.md").resolve()
    p = Path(val).expanduser()
    if p.is_absolute():
        return (p / "project_export.md").resolve()
    return (root / p / "project_export.md").resolve()


def dir_file_stats(path: Path) -> tuple[int, int]:
    count = 0
    total_bytes = 0
    for cur, _, names in os.walk(path):
        for n in names:
            count += 1
            try:
                total_bytes += (Path(cur) / n).stat().st_size
            except OSError:
                pass
    return count, total_bytes


def clean_exports_dir(root: Path, target_dir: Path, dangerous: set[str]) -> int:
    target_dir = target_dir.resolve()
    root_resolved = root.resolve()

    if root_resolved.name == "exports":
        print(
            f"Refusing to bulk-delete: project root directory '{root_resolved}' is named 'exports'.",
            file=sys.stderr,
        )
        return 1

    if target_dir == root_resolved:
        print(
            "Refusing to bulk-delete project root directory. Use 'make clean-export' to remove only project_export.md.",
            file=sys.stderr,
        )
        return 1

    if target_dir.name != "exports":
        print(
            f"Refusing to bulk-delete '{target_dir}': only directories named 'exports' can be bulk-cleaned.",
            file=sys.stderr,
        )
        return 1

    if str(target_dir) in dangerous or target_dir == Path.home().resolve():
        print(f"Refusing to clean protected path: {target_dir}", file=sys.stderr)
        return 1

    if not target_dir.exists() or not target_dir.is_dir():
        print(f"Nothing to clean ({target_dir} does not exist).")
        return 0

    children = list(target_dir.iterdir())
    if not children:
        print(f"Nothing to clean ({target_dir} is already empty).")
        return 0

    file_count, total_bytes = dir_file_stats(target_dir)
    top_dirs = sum(1 for c in children if c.is_dir())
    detail = f"{file_count} file(s)"
    if top_dirs > 0 and file_count == 0:
        detail = f"{top_dirs} empty folder(s)"

    print(f"About to delete {detail} ({human_size(total_bytes)}) inside: {target_dir}/")
    try:
        ans = input("Continue? [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print("\nCancelled.")
        return 0

    if ans not in ("y", "yes"):
        print("Cancelled.")
        return 0

    for item in children:
        if item.is_dir() and not item.is_symlink():
            shutil.rmtree(item)
        else:
            item.unlink()

    print(f"Cleaned {detail} ({human_size(total_bytes)}) from {target_dir}/.")
    return 0


def collect_files(
    root: Path,
    include: list[str],
    exportignore: list[str],
    skip_paths: set[Path] | None = None,
) -> list[Path]:
    files: list[Path] = []
    skip = {p.resolve() for p in (skip_paths or set())}
    for cur, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if not should_skip_dir(d)]
        for n in names:
            p = Path(cur) / n
            if p.resolve() in skip:
                continue
            rel = str(p.relative_to(root)).replace(os.sep, "/")
            if matches_ignore(rel, exportignore):
                continue
            if include and not any(fnmatch.fnmatch(rel, pat) for pat in include):
                continue
            if should_include_file(p):
                files.append(p)
    files.sort(key=lambda p: str(p).lower())
    return files


def lang_for(path: Path) -> str:
    name = path.name
    if name in {"Dockerfile", "Containerfile"}:
        return "dockerfile"
    if name in {"Makefile", "makefile", "GNUmakefile", "Justfile", "justfile"}:
        return "makefile"
    if name in {
        ".env.example",
        ".env.sample",
        ".env.template",
        ".gitignore",
        ".dockerignore",
        ".editorconfig",
        ".nvmrc",
        ".python-version",
        ".ruby-version",
        ".node-version",
        ".tool-versions",
    }:
        return "bash"
    if name in {
        "docker-compose.yml",
        "docker-compose.yaml",
        "compose.yml",
        "compose.yaml",
    }:
        return "yaml"
    return LANG_MAP.get(path.suffix.lower(), "")


def read_safe(path: Path) -> str | None:
    for encoding in ("utf-8", "latin-1"):
        try:
            return path.read_text(encoding=encoding)
        except UnicodeDecodeError:
            continue
        except Exception:
            return None
    return None


def main() -> None:
    ap = argparse.ArgumentParser(
        description="Export project source to a single markdown file."
    )
    ap.add_argument("-r", "--root", type=Path, default=Path(".").resolve())
    ap.add_argument(
        "-d", "--dir", default="exports", help="Output directory (default: exports)"
    )
    ap.add_argument("-o", "--output", type=Path, default=None)
    ap.add_argument("--max-size", default="2M")
    ap.add_argument("--include", action="append", default=[])
    ap.add_argument("--warn-mb", type=float, default=0.8)
    ap.add_argument(
        "--clean",
        action="store_true",
        help="Remove existing export file before regenerating",
    )
    ap.add_argument(
        "--clean-exports",
        action="store_true",
        help="Remove all files inside exports/ (with confirmation) without regenerating",
    )
    args = ap.parse_args()

    root = args.root.resolve()
    output = (
        args.output.resolve()
        if args.output
        else resolve_output_from_dir(root, args.dir)
    )
    max_size = parse_size(args.max_size)

    dangerous = {
        "/",
        "/home",
        "/usr",
        "/etc",
        "/var",
        "/boot",
        "/sys",
        "/proc",
        "/root",
    }

    if args.clean_exports:
        sys.exit(clean_exports_dir(root, output.parent, dangerous))

    if str(root) in dangerous or root == Path.home().resolve():
        print(f"Refusing to scan protected path: {root}")
        sys.exit(1)

    if not root.exists():
        print(f"Root not found: {root}")
        sys.exit(1)

    if args.clean and output.exists() and output.is_file():
        output.unlink()
        print(f"Removed old export: {output}")

    exportignore = load_exportignore(root)

    print(f"Scanning: {root}")
    print(f"Output:   {output}")
    print(f"Max size: {human_size(max_size)}")
    if exportignore:
        print(f"Ignore:   {len(exportignore)} rules from .exportignore")
    print()

    files = collect_files(root, args.include, exportignore, {output})
    if not files:
        print("No matching files.")
        sys.exit(1)

    skipped = collect_skipped(root, exportignore, {output})
    summaries = collect_dir_summaries(root, exportignore)
    print(
        f"Found {len(files)} files "
        f"({len(skipped)} skipped, {len(summaries)} dirs summarized). Writing...\n"
    )

    total = 0
    written = 0

    output.parent.mkdir(parents=True, exist_ok=True)
    with output.open("w", encoding="utf-8") as out:
        out.write(f"# Project Export — {root.name}\n\n")
        out.write(f"**Root:** `{root}`\n\n")
        out.write(f"**Files:** {len(files)}\n\n")
        out.write("---\n\n## Contents\n\n")

        valid: list[tuple[Path, str]] = []
        oversized: list[tuple[Path, int]] = []
        for f in files:
            try:
                fsize = f.stat().st_size
            except OSError:
                continue
            if fsize > max_size:
                oversized.append((f, fsize))
                print(f"  skipped (size): {f.relative_to(root)}")
                continue
            content = read_safe(f)
            if content is None:
                print(f"  skipped (read): {f.relative_to(root)}")
                continue
            valid.append((f, content))

        skipped = sorted(skipped + oversized, key=lambda x: str(x[0]).lower())

        for f, _ in valid:
            out.write(f"- `{f.relative_to(root)}`\n")
        for f, size in skipped:
            out.write(
                f"- `{f.relative_to(root)}` ({human_size(size)}, content omitted)\n"
            )
        for d, size in summaries:
            out.write(
                f"- `{d.relative_to(root)}/` ({human_size(size)}, content omitted)\n"
            )
        out.write("\n---\n\n")

        for f, content in valid:
            rel = f.relative_to(root)
            size = len(content.encode("utf-8"))
            total += size
            written += 1

            out.write(f"## `{rel}`\n\n")
            out.write(f"Size: {size:,} bytes\n\n")
            if not content.strip():
                out.write("_(empty file)_\n\n")
            out.write(f"```{lang_for(f)}\n")
            out.write(content)
            if not content.endswith("\n"):
                out.write("\n")
            out.write("```\n\n---\n\n")

        for f, size in skipped:
            rel = f.relative_to(root)
            out.write(f"## `{rel}`\n\n")
            out.write(f"Size: {size:,} bytes\n\n")
            out.write("_(Content was not included by export.py)_\n\n")
            out.write("---\n\n")

        for d, size in summaries:
            rel = d.relative_to(root)
            out.write(f"## `{rel}/`\n\n")
            out.write(f"Size: {size:,} bytes\n\n")
            out.write("_(Directory content was not included by export.py)_\n\n")
            out.write("---\n\n")

    size_mb = total / (1024 * 1024)
    try:
        est_tokens = output.stat().st_size // 4
    except OSError:
        est_tokens = total // 4
    print(f"\nDone.")
    print(
        f"Files: {written} included, {len(skipped)} skipped, "
        f"{len(summaries)} dirs summarized, Total: {human_size(total)} (~{est_tokens:,} tokens)"
    )
    print(f"Output: {output}")

    if size_mb > args.warn_mb:
        print(f"\nWarning: {size_mb:.2f} MB exceeds {args.warn_mb} MB threshold.")
        print("Add .exportignore rules or narrow with --include.")


if __name__ == "__main__":
    main()
