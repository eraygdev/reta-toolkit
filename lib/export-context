def human_size(n: float) -> str:
    for unit in ["B", "KB", "MB", "GB"]:
        if n < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def parse_size(s: str) -> int:
    s = s.strip().upper()
    if not s:
        return 0
    mult = {"K": 1024, "M": 1024**2, "G": 1024**3, "B": 1}
    if s[-1] in mult:
        return int(float(s[:-1]) * mult[s[-1]])
    return int(s)


def load_exportignore(root: Path) -> list[str]:
    path = root / ".exportignore"
    if not path.exists():
        return []
    return [
        line.strip()
        for line in path.read_text(encoding="utf-8").splitlines()
        if line.strip() and not line.strip().startswith("#")
    ]


def matches_ignore(rel_path: str, patterns: list[str]) -> bool:
    for pat in patterns:
        if pat.endswith("/"):
            if rel_path.startswith(pat.rstrip("/") + "/") or rel_path == pat.rstrip(
                "/"
            ):
                return True
        elif fnmatch.fnmatch(rel_path, pat):
            return True
        elif "/" not in pat and fnmatch.fnmatch(Path(rel_path).name, pat):
            return True
    return False


def should_skip_dir(name: str) -> bool:
    if name == ".github":
        return False
    return name in EXCLUDE_DIRS or name.startswith(".")


def should_include_file(path: Path) -> bool:
    name = path.name
    suffix = path.suffix.lower()

    if name in EXCLUDE_NAMES or suffix in EXCLUDE_EXT:
        return False
    if name in INCLUDE_NAMES:
        return True
    if name.startswith(".env."):
        return name == ".env.example"
    if suffix in INCLUDE_EXT:
        return True
    # Extension-less scripts with shebang
    if not suffix:
        try:
            with path.open("rb") as f:
                return f.read(2) == b"#!"
        except Exception:
            return False
    return False


def collect_files(
    root: Path, include: list[str], exportignore: list[str]
) -> list[Path]:
    files: list[Path] = []
    for cur, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if not should_skip_dir(d)]
        for n in names:
            p = Path(cur) / n
            rel = str(p.relative_to(root)).replace(os.sep, "/")
            if matches_ignore(rel, exportignore):
                continue
            if include and not any(fnmatch.fnmatch(rel, pat) for pat in include):
                continue
            if ".github" in rel and n.endswith((".yml", ".yaml")):
                files.append(p)
                continue
            if should_include_file(p):
                files.append(p)
    files.sort(key=lambda p: str(p).lower())
    return files


def lang_for(path: Path) -> str:
    name = path.name
    if name in {"Dockerfile", "Containerfile"}:
        return "dockerfile"
    if name in {"Makefile", "makefile", "GNUmakefile", "Justfile", "justfile"}:
        return "makefile"
    if name in {
        ".env.example",
        ".env.sample",
        ".env.template",
        ".gitignore",
        ".dockerignore",
        ".editorconfig",
        ".nvmrc",
        ".python-version",
        ".ruby-version",
        ".node-version",
        ".tool-versions",
    }:
        return "bash"
    if name in {
        "docker-compose.yml",
        "docker-compose.yaml",
        "compose.yml",
        "compose.yaml",
    }:
        return "yaml"
    return LANG_MAP.get(path.suffix.lower(), "")


def read_safe(path: Path) -> str | None:
    for encoding in ("utf-8", "latin-1"):
        try:
            return path.read_text(encoding=encoding)
        except UnicodeDecodeError:
            continue
        except Exception:
            return None
    return None


def main() -> None:
    ap = argparse.ArgumentParser(
        description="Export project source to a single markdown file."
    )
    ap.add_argument("-r", "--root", type=Path, default=Path(".").resolve())
    ap.add_argument("-o", "--output", type=Path, default=None)
    ap.add_argument("--max-size", default="2M")
    ap.add_argument("--include", action="append", default=[])
    ap.add_argument("--warn-mb", type=float, default=0.8)
    args = ap.parse_args()

    root = args.root.resolve()
    output = (args.output or (root / "project_export.md")).resolve()
    max_size = parse_size(args.max_size)

    dangerous = {
        "/",
        "/home",
        "/usr",
        "/etc",
        "/var",
        "/boot",
        "/sys",
        "/proc",
        "/root",
    }
    if str(root) in dangerous or root == Path.home().resolve():
        print(f"Refusing to scan protected path: {root}")
        sys.exit(1)

    if not root.exists():
        print(f"Root not found: {root}")
        sys.exit(1)

    exportignore = load_exportignore(root)

    print(f"Scanning: {root}")
    print(f"Output:   {output}")
    print(f"Max size: {human_size(max_size)}")
    if exportignore:
        print(f"Ignore:   {len(exportignore)} rules from .exportignore")
    print()

    files = collect_files(root, args.include, exportignore)
    if not files:
        print("No matching files.")
        sys.exit(1)

    print(f"Found {len(files)} files. Writing...\n")

    total = 0
    written = 0

    with output.open("w", encoding="utf-8") as out:
        out.write(f"# Project Export — {root.name}\n\n")
        out.write(f"**Root:** `{root}`\n\n")
        out.write(f"**Files:** {len(files)}\n\n")
        out.write("---\n\n## Contents\n\n")

        valid: list[tuple[Path, str]] = []
        for f in files:
            try:
                if f.stat().st_size > max_size:
                    print(f"  skipped (size): {f.relative_to(root)}")
                    continue
            except OSError:
                continue
            content = read_safe(f)
            if content is None:
                print(f"  skipped (read): {f.relative_to(root)}")
                continue
            valid.append((f, content))

        for f, _ in valid:
            out.write(f"- `{f.relative_to(root)}`\n")
        out.write("\n---\n\n")

        for f, content in valid:
            rel = f.relative_to(root)
            size = len(content.encode("utf-8"))
            total += size
            written += 1

            out.write(f"## `{rel}`\n\n")
            out.write(f"Size: {size:,} bytes\n\n")
            if not content.strip():
                out.write("_(empty file)_\n\n")
            out.write(f"```{lang_for(f)}\n")
            out.write(content)
            if not content.endswith("\n"):
                out.write("\n")
            out.write("```\n\n---\n\n")

    size_mb = total / (1024 * 1024)
    print(f"\nDone.")
    print(f"Files: {written}, Total: {human_size(total)}")
    print(f"Output: {output}")

    if size_mb > args.warn_mb:
        print(f"\nWarning: {size_mb:.2f} MB exceeds {args.warn_mb} MB threshold.")
        print("Add .exportignore rules or narrow with --include.")


if __name__ == "__main__":
    main()
