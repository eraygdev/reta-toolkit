#!/usr/bin/env python3
"""
Scan a project for tracked sensitive files, missing .gitignore rules,
and hardcoded secrets or private keys.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from ui import BOLD, CYAN, DIM, GREEN, RED, RESET, YELLOW, next_steps  # noqa: E402

IGNORE_MARKER = "check-secrets: ignore"

SENSITIVE_FILENAMES = {
    ".env",
    ".env.local",
    ".env.production",
    ".env.prod",
    ".env.staging",
    ".env.development",
    ".env.dev",
    ".env.test",
    "id_rsa",
    "id_ed25519",
    "id_ecdsa",
}

SENSITIVE_EXTS = {
    ".pem",
    ".key",
    ".p12",
    ".pfx",
}

SKIP_FILES = {
    ".env.example",
    ".env.sample",
    ".env.template",
    "project_export.md",
    "project_export.txt",
}

SKIP_DIRS = {
    ".git",
    ".hg",
    ".svn",
    "__pycache__",
    "venv",
    ".venv",
    "env",
    "node_modules",
    "dist",
    "build",
    "target",
    ".next",
    ".nuxt",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
}

SECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [
    (
        "Private key block",
        re.compile(r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----"),
    ),
    ("OpenAI API key", re.compile(r"\bsk-(?:proj-)?[A-Za-z0-9_-]{24,}\b")),
    ("Anthropic API key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}\b")),
    ("Google/Gemini API key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    (
        "GitHub token",
        re.compile(r"\b(?:gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,})\b"),
    ),
    ("AWS Access Key ID", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("Slack token", re.compile(r"\bxox[baprs]-[0-9A-Za-z-]{10,}\b")),
    ("Stripe live secret", re.compile(r"\bsk_live_[0-9A-Za-z]{20,}\b")),
]


def is_git_repo(root: Path) -> bool:
    return (root / ".git").exists()


def git_tracked_files(root: Path) -> list[Path]:
    res = subprocess.run(
        ["git", "-C", str(root), "ls-files", "-z"],
        capture_output=True,
        check=False,
    )
    if res.returncode != 0:
        return []
    raw = res.stdout.decode("utf-8", errors="replace")
    return [root / p for p in raw.split("\0") if p]


def walk_project_files(root: Path) -> list[Path]:
    files: list[Path] = []
    for cur, dirs, names in os.walk(root):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for name in names:
            files.append(Path(cur) / name)
    return files


def check_gitignore(root: Path) -> tuple[bool, str]:
    gitignore = root / ".gitignore"
    if not gitignore.exists():
        return False, ".gitignore not found"

    patterns = {
        line.strip()
        for line in gitignore.read_text(encoding="utf-8", errors="replace").splitlines()
        if line.strip() and not line.strip().startswith("#")
    }
    env_rules = {".env", "/.env", ".env*", "/.env*", "*.env", "**/.env", "**/.env*"}
    if patterns & env_rules:
        return True, ".env is ignored in .gitignore"
    return False, ".env is not listed in .gitignore"


def is_binary_or_large(path: Path, max_bytes: int = 1024 * 1024) -> bool:
    try:
        if not path.is_file() or path.stat().st_size > max_bytes:
            return True
        with path.open("rb") as f:
            chunk = f.read(4096)
        return b"\x00" in chunk
    except OSError:
        return True


def scan_file(path: Path, root: Path) -> list[tuple[Path, int, str]]:
    findings: list[tuple[Path, int, str]] = []
    name = path.name
    if name in SKIP_FILES or name.startswith(".env"):
        return findings
    if is_binary_or_large(path):
        return findings

    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return findings

    rel = path.relative_to(root)
    for lineno, line in enumerate(text.splitlines(), start=1):
        if IGNORE_MARKER in line:
            continue
        for label, pattern in SECRET_PATTERNS:
            if pattern.search(line):
                findings.append((rel, lineno, label))
                break
    return findings


def main() -> int:
    root = Path.cwd().resolve()
    in_git = is_git_repo(root)

    print(f"{BOLD}check-secrets{RESET}")
    print(f"  root: {root}")
    print("")

    failures = 0
    warnings = 0

    # 1. Check .gitignore coverage
    ok_ignore, ignore_msg = check_gitignore(root)
    if ok_ignore:
        print(f"  {GREEN}OK{RESET}    {ignore_msg}")
    else:
        print(f"  {YELLOW}WARN{RESET}  {ignore_msg}")
        warnings += 1

    # 2. Check for tracked sensitive files in git
    tracked_sensitive: list[Path] = []
    if in_git:
        tracked = git_tracked_files(root)
        for p in tracked:
            if p.name in SKIP_FILES:
                continue
            if (
                p.name in SENSITIVE_FILENAMES
                or p.name.startswith(".env.")
                or p.suffix.lower() in SENSITIVE_EXTS
            ):
                tracked_sensitive.append(p.relative_to(root))

        if tracked_sensitive:
            print(
                f"  {RED}FAIL{RESET}  Sensitive file(s) tracked by git ({len(tracked_sensitive)}):"
            )
            for rel in tracked_sensitive:
                print(f"        - {CYAN}{rel}{RESET}")
            failures += len(tracked_sensitive)
        else:
            print(f"  {GREEN}OK{RESET}    No sensitive files tracked by git")
        scan_candidates = tracked
    else:
        print(f"  {DIM}Not a git repository; scanning working directory files{RESET}")
        scan_candidates = walk_project_files(root)

    # 3. Scan source files for leaked secrets
    leaks: list[tuple[Path, int, str]] = []
    for path in scan_candidates:
        leaks.extend(scan_file(path, root))

    if leaks:
        print(
            f"  {RED}FAIL{RESET}  Potential hardcoded secret(s) found ({len(leaks)}):"
        )
        for rel, lineno, label in leaks:
            print(f"        - {CYAN}{rel}:{lineno}{RESET} ({label})")
        failures += len(leaks)
    else:
        print(
            f"  {GREEN}OK{RESET}    No hardcoded secrets detected ({len(scan_candidates)} files scanned)"
        )

    print("")
    if failures > 0:
        print(f"{RED}Summary:{RESET} {failures} issue(s), {warnings} warning(s)")
        steps = []
        if tracked_sensitive:
            steps.append(
                "git rm --cached <file>   Untrack sensitive file without deleting it locally"
            )
        if leaks:
            steps.append(
                "Move secrets to .env, or add '# check-secrets: ignore' if false positive"
            )
        next_steps(steps)
        return 1

    print(f"{GREEN}Summary:{RESET} clean ({warnings} warning(s))")
    return 0


if __name__ == "__main__":
    sys.exit(main())
