#!/usr/bin/env python3
"""
Convert an existing project Makefile to work with ~/.reta/lib/base.mk.

Preserves variables, conditionals, recipes (including leading tabs), and
section headings while commenting out targets that collide with base.mk.
"""

from __future__ import annotations

import argparse
import re
import shutil
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from ui import BOLD, CYAN, DIM, GREEN, RED, RESET, YELLOW, next_steps  # noqa: E402

TARGET_LINE_RE = re.compile(
    r"^([A-Za-z0-9_./%-]+(?:\s+[A-Za-z0-9_./%-]+)*)\s*:(?![=:])(.*)$"
)
ASSIGN_RE = re.compile(r"^[A-Za-z0-9_.-]+\s*(?:\?=|:=|\+=|!=|=)")
DECORATED_HEADING_RE = re.compile(
    r"^#\s*(?:===+|---|###|\*\*\*|═══+|───+|━━━+)\s*(.+?)\s*(?:===+|---|###|\*\*\*|═══+|───+|━━━+)\s*$"
)
BANNER_LINE_RE = re.compile(r"^#\s*[=\-*#═─━~_]{4,}\s*$")
HELP_ECHO_CMD_RE = re.compile(
    r"""^\t\s*@?echo\s+["']\s*(make\s+)?([A-Za-z0-9_.-]+)(?:\s{2,}|\s+[-:]\s+)(.+?)["']\s*$"""
)
HELP_PRINTF_CMD_RE = re.compile(
    r"""^\t\s*@?printf\s+["'][^"']*["']\s+["']([A-Za-z0-9_.-]+)["']\s+["'](.+?)["']\s*$"""
)
REDUNDANT_DEFAULTS = {
    "SHELL := /bin/bash",
    "SHELL = /bin/bash",
    ".DEFAULT_GOAL := help",
    ".DEFAULT_GOAL = help",
}
DIRECTIVES = {
    ".PHONY",
    ".DEFAULT_GOAL",
    ".SILENT",
    ".IGNORE",
    ".EXPORT_ALL_VARIABLES",
    ".PRECIOUS",
    ".SECONDARY",
}

FALLBACK_HEADER = """# Project Makefile (powered by ~/.reta/lib/base.mk)
#
# Rules & usage:
#   - Inherited targets: `up`, `down`, `logs`, `clean`, `export`, `git-sync`, ...
#   - Do NOT define `help:` — `base.mk` generates a combined `help` for all targets.
#   - Override any other base target (e.g. `clean`, `up`) by defining it below
#     `include $(RETA_BASE)`. (Converted Makefiles comment out colliding rules
#     first; uncomment any of them to restore your custom behavior.)
#   - Section heading: `# === Section Name ===` (shown as a bold yellow header).
#   - Documented target: `name:  ## Short description` (targets without `##`
#     still run normally, but stay hidden from `make help`).

RETA_BASE := $(HOME)/.reta/lib/base.mk
ifeq ($(wildcard $(RETA_BASE)),)
$(error reta not installed: $(RETA_BASE) missing. Run install.sh from your reta repo)
endif
include $(RETA_BASE)
"""


def load_template_header(lib_dir: Path) -> str:
    tpl = lib_dir.parent / "templates" / "Makefile"
    if not tpl.exists():
        return FALLBACK_HEADER
    lines = tpl.read_text(encoding="utf-8").splitlines()
    out: list[str] = []
    for line in lines:
        out.append(line)
        if line.strip() == "include $(RETA_BASE)":
            return "\n".join(out) + "\n"
    return FALLBACK_HEADER


def load_base_targets(base_mk: Path) -> set[str]:
    targets: set[str] = {"help"}
    if not base_mk.exists():
        return targets
    for line in base_mk.read_text(encoding="utf-8").splitlines():
        if line.startswith("\t") or line.startswith("#") or not line.strip():
            continue
        m = TARGET_LINE_RE.match(line)
        if not m:
            continue
        for name in m.group(1).split():
            if name not in DIRECTIVES and not name.startswith("."):
                targets.add(name)
    return targets


def already_uses_reta(text: str) -> bool:
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("#"):
            continue
        if "RETA_BASE" in s or ("base.mk" in s and "include" in s):
            return True
    return False


def split_blocks(lines: list[str]) -> list[tuple[str, list[str]]]:
    """
    Split Makefile lines into structural blocks:
      - ('directive', [...])  conditional/define/include/variable blocks
      - ('target', [...])     target header + recipe lines
      - ('comment', [...])    single comment line
      - ('blank', [...])      empty line
      - ('raw', [...])        other standalone line
    """
    blocks: list[tuple[str, list[str]]] = []
    i = 0
    n = len(lines)

    while i < n:
        line = lines[i]
        stripped = line.strip()

        if not stripped:
            blocks.append(("blank", [line]))
            i += 1
            continue

        # Conditional blocks (ifeq / ifneq / ifdef / ifndef ... endif)
        if re.match(r"^(?:ifeq|ifneq|ifdef|ifndef)\b", stripped):
            chunk = [line]
            depth = 1
            i += 1
            while i < n and depth > 0:
                cur = lines[i]
                cs = cur.strip()
                if re.match(r"^(?:ifeq|ifneq|ifdef|ifndef)\b", cs):
                    depth += 1
                elif re.match(r"^endif\b", cs):
                    depth -= 1
                chunk.append(cur)
                i += 1
            blocks.append(("directive", chunk))
            continue

        # define ... endef blocks
        if re.match(r"^(?:override\s+)?define\b", stripped):
            chunk = [line]
            i += 1
            while i < n:
                cur = lines[i]
                chunk.append(cur)
                i += 1
                if cur.strip() == "endef":
                    break
            blocks.append(("directive", chunk))
            continue

        if stripped.startswith("#"):
            blocks.append(("comment", [line]))
            i += 1
            continue

        # Variable assignment (with optional trailing backslash continuation)
        if ASSIGN_RE.match(line) and not line.startswith("\t"):
            chunk = [line]
            while chunk[-1].rstrip().endswith("\\") and i + 1 < n:
                i += 1
                chunk.append(lines[i])
            blocks.append(("directive", chunk))
            i += 1
            continue

        # Target rule (not starting with TAB, and not a dot-directive like .PHONY)
        if not line.startswith("\t"):
            m = TARGET_LINE_RE.match(line)
            if m:
                first_tok = m.group(1).split()[0]
                if first_tok in DIRECTIVES or first_tok.startswith("."):
                    chunk = [line]
                    while chunk[-1].rstrip().endswith("\\") and i + 1 < n:
                        i += 1
                        chunk.append(lines[i])
                    blocks.append(("directive", chunk))
                    i += 1
                    continue

                chunk = [line]
                while chunk[-1].rstrip().endswith("\\") and i + 1 < n:
                    i += 1
                    chunk.append(lines[i])
                i += 1

                # Collect recipe lines (TAB-prefixed, or comments/blanks between recipe lines)
                while i < n:
                    nxt = lines[i]
                    if nxt.startswith("\t"):
                        chunk.append(nxt)
                        while chunk[-1].rstrip().endswith("\\") and i + 1 < n:
                            i += 1
                            chunk.append(lines[i])
                        i += 1
                    elif not nxt.strip():
                        # Keep blank line inside recipe only if another TAB line follows immediately
                        look = i + 1
                        while look < n and not lines[look].strip():
                            look += 1
                        if look < n and lines[look].startswith("\t"):
                            chunk.append(nxt)
                            i += 1
                        else:
                            break
                    else:
                        break
                blocks.append(("target", chunk))
                continue

        blocks.append(("raw", [line]))
        i += 1

    return blocks


def collect_target_names(blocks: list[tuple[str, list[str]]]) -> set[str]:
    names: set[str] = set()
    for kind, chunk in blocks:
        if kind != "target":
            continue
        m = TARGET_LINE_RE.match(chunk[0])
        if m:
            names.update(m.group(1).split())
    return names


def extract_help_descriptions(blocks: list[tuple[str, list[str]]]) -> dict[str, str]:
    known_targets = collect_target_names(blocks)
    descriptions: dict[str, str] = {}
    for kind, chunk in blocks:
        if kind != "target":
            continue
        m = TARGET_LINE_RE.match(chunk[0])
        if not m:
            continue
        names = m.group(1).split()
        if "help" not in names:
            continue
        for line in chunk[1:]:
            em = HELP_ECHO_CMD_RE.match(line)
            if em:
                has_make_prefix = em.group(1) is not None
                tname = em.group(2).strip()
                desc = em.group(3).strip().rstrip("\"'")
                if not has_make_prefix and tname not in known_targets:
                    continue
                if tname and desc and tname not in descriptions:
                    descriptions[tname] = desc
                continue
            pm = HELP_PRINTF_CMD_RE.match(line)
            if pm:
                tname = pm.group(1).strip()
                desc = pm.group(2).strip().rstrip("\"'")
                if tname and desc and tname not in descriptions:
                    descriptions[tname] = desc
    return descriptions


def next_non_blank_kind(blocks: list[tuple[str, list[str]]], idx: int) -> str | None:
    j = idx + 1
    while j < len(blocks):
        if blocks[j][0] == "blank":
            j += 1
            continue
        if blocks[j][0] == "comment" and BANNER_LINE_RE.match(blocks[j][1][0].strip()):
            j += 1
            continue
        return blocks[j][0]
    return None


def classify_heading(
    blocks: list[tuple[str, list[str]]], idx: int
) -> tuple[str, str | None]:
    """
    Return (status, title):
      - ('heading', title): confident section heading
      - ('uncertain', title): possibly a heading, mark with EDIT_HERE
      - ('normal', None): regular comment
    """
    line = blocks[idx][1][0].strip()

    if BANNER_LINE_RE.match(line):
        return ("banner", None)

    dm = DECORATED_HEADING_RE.match(line)
    if dm:
        title = dm.group(1).strip()
        if title and not title.lower().startswith("edit_here"):
            return ("heading", title)

    text = line.lstrip("#").strip()
    if not text:
        return ("normal", None)

    prev_is_blank_or_banner = (
        idx == 0
        or blocks[idx - 1][0] == "blank"
        or (
            blocks[idx - 1][0] == "comment"
            and BANNER_LINE_RE.match(blocks[idx - 1][1][0].strip()) is not None
        )
    )
    prev_is_banner = idx > 0 and (
        blocks[idx - 1][0] == "comment"
        and BANNER_LINE_RE.match(blocks[idx - 1][1][0].strip()) is not None
    )
    next_is_banner = idx + 1 < len(blocks) and (
        blocks[idx + 1][0] == "comment"
        and BANNER_LINE_RE.match(blocks[idx + 1][1][0].strip()) is not None
    )

    if prev_is_banner and next_is_banner and len(text) <= 100:
        return ("heading", text)

    if len(text) > 48:
        return ("normal", None)

    nxt = next_non_blank_kind(blocks, idx)
    words = text.split()
    looks_uppercase_title = (
        text == text.upper()
        and any(c.isalpha() for c in text)
        and len(words) <= 5
        and "=" not in text
        and ":" not in text
    )

    if looks_uppercase_title and prev_is_blank_or_banner and nxt == "target":
        return ("heading", text)

    if looks_uppercase_title and prev_is_blank_or_banner:
        return ("uncertain", text)

    half_decorated = re.match(r"^(?:===+|---|###|\*\*\*)\s*(.+)$", text)
    if half_decorated:
        candidate = half_decorated.group(1).strip()
        if candidate:
            return ("uncertain", candidate)

    looks_title_case = (
        1 <= len(words) <= 3
        and all(w[:1].isupper() and w[0].isalpha() for w in words)
        and not text.endswith(".")
        and "=" not in text
        and ":" not in text
    )
    if looks_title_case and prev_is_blank_or_banner and nxt == "target":
        return ("uncertain", text)

    return ("normal", None)


def adjacent_comment_desc(
    blocks: list[tuple[str, list[str]]], target_idx: int
) -> str | None:
    """Return a short adjacent comment directly above target_idx, if appropriate."""
    comment_lines: list[str] = []
    j = target_idx - 1
    while j >= 0 and blocks[j][0] == "comment":
        status, _ = classify_heading(blocks, j)
        if status != "normal":
            return None
        comment_lines.append(blocks[j][1][0].strip().lstrip("#").strip())
        j -= 1
    if not comment_lines:
        return None
    comment_lines.reverse()
    for text in comment_lines:
        if not text:
            continue
        low = text.lower()
        if low.startswith(("kullanim:", "usage:", "[reta]", "edit_here")):
            continue
        if len(text) <= 80:
            return text
    return None


def convert_target_header(
    header_line: str, help_descs: dict[str, str], fallback_desc: str | None = None
) -> tuple[str, str]:
    """
    Ensure `## description` exists on active project targets:
      - keep existing `## ...`              -> ('existing', line)
      - upgrade `# ...` or help: match      -> ('annotated', line)
      - add placeholder when undocumented   -> ('placeholder', line)
    """
    m = TARGET_LINE_RE.match(header_line)
    if not m:
        return "existing", header_line

    targets_part = m.group(1)
    rest = m.group(2)

    if "##" in rest:
        return "existing", header_line

    if "#" in rest:
        before, _, comment = rest.partition("#")
        comment = comment.strip()
        if comment:
            return "annotated", f"{targets_part}:{before.rstrip()}  ## {comment}"
        return "existing", header_line

    names = targets_part.split()
    if len(names) == 1 and names[0] in help_descs:
        desc = help_descs[names[0]]
        sep = "  " if not rest.endswith(" ") else " "
        return "annotated", f"{targets_part}:{rest.rstrip()}{sep}## {desc}"

    if fallback_desc:
        clean_rest = rest.split("#", 1)[0].rstrip()
        sep = "  " if not clean_rest.endswith(" ") else " "
        return "annotated", f"{targets_part}:{clean_rest}{sep}## {fallback_desc}"

    clean_rest = rest.split("#", 1)[0].rstrip()
    sep = "  " if not clean_rest.endswith(" ") else " "
    return (
        "placeholder",
        f"{targets_part}:{clean_rest}{sep}## EDIT_HERE: add description",
    )


def convert_makefile(
    content: str, base_targets: set[str], header_block: str
) -> tuple[str, dict[str, list[str]]]:
    lines = content.splitlines()
    blocks = split_blocks(lines)
    help_descs = extract_help_descriptions(blocks)

    report: dict[str, list[str]] = {
        "headings": [],
        "commented_targets": [],
        "annotated_targets": [],
        "hidden_targets": [],
        "edit_here": [],
    }

    out_lines: list[str] = [header_block.rstrip("\n"), ""]

    skip_leading_blanks = True
    i = 0
    while i < len(blocks):
        kind, chunk = blocks[i]

        if skip_leading_blanks and kind == "blank":
            i += 1
            continue
        skip_leading_blanks = False

        if kind == "comment":
            status, title = classify_heading(blocks, i)
            if status == "banner":
                # Drop standalone separator banners adjacent to a converted heading
                prev_h = (
                    i - 1 >= 0
                    and blocks[i - 1][0] == "comment"
                    and classify_heading(blocks, i - 1)[0] == "heading"
                )
                next_h = (
                    i + 1 < len(blocks)
                    and blocks[i + 1][0] == "comment"
                    and classify_heading(blocks, i + 1)[0] == "heading"
                )
                if prev_h or next_h:
                    i += 1
                    continue
                out_lines.extend(chunk)
            elif status == "heading" and title:
                out_lines.append(f"# === {title} ===")
                report["headings"].append(title)
            elif status == "uncertain" and title:
                out_lines.append(
                    f"# EDIT_HERE: verify if '{title}' is a section heading -> # === {title} ==="
                )
                out_lines.extend(chunk)
                report["edit_here"].append(f"Possible section heading: {title}")
            else:
                out_lines.extend(chunk)
            i += 1
            continue

        if kind == "target":
            m = TARGET_LINE_RE.match(chunk[0])
            names = m.group(1).split() if m else []
            colliding = [n for n in names if n in base_targets]

            if colliding:
                joined = ", ".join(colliding)
                if colliding == ["help"]:
                    out_lines.append(
                        "# [reta] Commented out old 'help' target (base.mk provides combined help)"
                    )
                else:
                    out_lines.append(
                        f"# [reta] Commented out '{joined}' (provided by base.mk; uncomment to override)"
                    )
                for line in chunk:
                    out_lines.append(f"# {line}" if line else "#")
                report["commented_targets"].extend(colliding)
            else:
                fallback_desc = adjacent_comment_desc(blocks, i)
                status, new_head = convert_target_header(
                    chunk[0], help_descs, fallback_desc
                )
                if status == "annotated" and names:
                    report["annotated_targets"].append(names[0])
                elif status == "placeholder" and names:
                    report["hidden_targets"].append(names[0])
                    report["edit_here"].append(
                        f"Missing description on target: {names[0]}"
                    )
                out_lines.append(new_head)
                out_lines.extend(chunk[1:])
            i += 1
            continue

        if kind == "directive" and len(chunk) == 1:
            norm = " ".join(chunk[0].strip().split())
            if norm in REDUNDANT_DEFAULTS:
                out_lines.append(
                    f"# [reta] Commented redundant '{norm}' (defined in base.mk)"
                )
                out_lines.append(f"# {chunk[0]}")
                i += 1
                continue

        out_lines.extend(chunk)
        i += 1

    # Demote section headings that have no active targets beneath them
    body_lines = out_lines[1:]
    boundary_indices = [
        idx
        for idx, ln in enumerate(body_lines)
        if (ln.startswith("# === ") and ln.endswith(" ==="))
        or ln.startswith("# EDIT_HERE: verify if ")
    ]
    for pos, h_idx in enumerate(boundary_indices):
        ln_head = body_lines[h_idx]
        if not (ln_head.startswith("# === ") and ln_head.endswith(" ===")):
            continue
        title = ln_head[6:-4].strip()
        end_idx = (
            boundary_indices[pos + 1]
            if pos + 1 < len(boundary_indices)
            else len(body_lines)
        )
        section_slice = body_lines[h_idx + 1 : end_idx]

        # A dedicated HELP section only exists for the old help target
        is_help_section = title.upper() == "HELP" and any(
            ln.startswith("# [reta] Commented out old 'help' target")
            for ln in section_slice
        )

        has_active_target = False
        if not is_help_section:
            for ln in section_slice:
                if not ln.strip() or ln.startswith("#") or ln.startswith("\t"):
                    continue
                if ASSIGN_RE.match(ln):
                    continue
                tm = TARGET_LINE_RE.match(ln)
                if tm:
                    first_tok = tm.group(1).split()[0]
                    if first_tok not in DIRECTIVES and not first_tok.startswith("."):
                        has_active_target = True
                        break
        if not has_active_target:
            body_lines[h_idx] = f"# {title}"
            if title in report["headings"]:
                report["headings"].remove(title)

    out_lines = [out_lines[0]] + body_lines

    # Collapse 3+ consecutive blank lines into 2
    cleaned: list[str] = []
    blank_run = 0
    for line in out_lines:
        if not line.strip():
            blank_run += 1
            if blank_run <= 2:
                cleaned.append("")
        else:
            blank_run = 0
            cleaned.append(line)

    result = "\n".join(cleaned).rstrip() + "\n"
    return result, report


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Convert an existing Makefile to use ~/.reta/lib/base.mk."
    )
    ap.add_argument("target", nargs="?", default="Makefile", help="Makefile path")
    ap.add_argument(
        "-n", "--dry-run", action="store_true", help="Preview without modifying"
    )
    ap.add_argument(
        "--no-backup", action="store_true", help="Skip creating Makefile.bak"
    )
    ap.add_argument(
        "--no-hints", action="store_true", help="Suppress Next steps output"
    )
    ap.add_argument(
        "--summary-only", action="store_true", help="Print only conversion summary"
    )
    args = ap.parse_args()
    mk_path = Path(args.target)
    if not mk_path.is_file():
        print(f"{RED}Error:{RESET} {mk_path} not found.", file=sys.stderr)
        return 1

    original = mk_path.read_text(encoding="utf-8")
    if already_uses_reta(original):
        print(f"  {DIM}skip  {mk_path.name} (already uses base.mk){RESET}")
        return 0

    lib_dir = Path(__file__).resolve().parent
    base_targets = load_base_targets(lib_dir / "base.mk")
    header_block = load_template_header(lib_dir)

    converted, report = convert_makefile(original, base_targets, header_block)

    def fmt_list(items: list[str], limit: int = 5) -> str:
        if len(items) <= limit:
            return ", ".join(items)
        return f"{', '.join(items[:limit])} (+{len(items) - limit} more)"

    if args.dry_run:
        print(f"{DIM}--- dry run: {mk_path} ---{RESET}")
        print(converted)
        print(f"{DIM}--- end ---{RESET}")
    else:
        backup_path = mk_path.with_name(mk_path.name + ".bak")
        if not args.no_backup:
            shutil.copy2(mk_path, backup_path)
        mk_path.write_text(converted, encoding="utf-8")
        if not args.summary_only:
            print(f"  {GREEN}conv  {mk_path.name}{RESET}")
            if not args.no_backup:
                print(f"  {DIM}backup {backup_path.name}{RESET}")

    if not args.summary_only:
        print("")
    if report["headings"]:
        print(f"  {CYAN}Headings:{RESET}          {fmt_list(report['headings'])}")
    if report["annotated_targets"]:
        print(
            f"  {CYAN}Added '##': {RESET}       {fmt_list(report['annotated_targets'])}"
        )
    if report["hidden_targets"]:
        print(
            f"  {YELLOW}Needs description:{RESET} {fmt_list(report['hidden_targets'])} "
            f"{DIM}(marked with EDIT_HERE){RESET}"
        )
    if report["commented_targets"]:
        print(
            f"  {YELLOW}Commented out:{RESET}     {fmt_list(report['commented_targets'])} "
            f"{DIM}(already in base.mk; uncomment to override){RESET}"
        )
    if report["edit_here"]:
        print(
            f"  {YELLOW}Review EDIT_HERE:{RESET}  {len(report['edit_here'])} item(s) marked in {mk_path.name}"
        )

    if not args.no_hints:
        steps = ["make help          Verify converted targets and headings"]
        if report["edit_here"]:
            steps.append(f"grep EDIT_HERE {mk_path.name}   Review marked items")
        if not args.dry_run and not args.no_backup:
            steps.append(f"rm {mk_path.name}.bak     Remove backup once verified")
        next_steps(steps)
    return 0


if __name__ == "__main__":
    sys.exit(main())
