# Environment variables template.
#
# This file is copied into each project by `devkit init`. After that, run
# `devkit init-env` to generate the real `.env` file (never committed).
# This file stays in git so the team knows which variables are required.
#
# Special value markers (resolved by `devkit init-env`):
#   GENERATE_SECRET  → 64-character random hex (secrets.token_hex(32))
#   AUTO_HASH        → bcrypt hash of a password prompted at runtime
#   (empty)          → value prompted interactively
#
# ---------------------------------------------------------------------------

# Application
APP_NAME=myapp
APP_ENV=development
APP_KEY=GENERATE_SECRET
APP_DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/myapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE_SECRET
POSTGRES_DB=myapp

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# External APIs (prompted at setup)
GEMINI_API_KEY=
OPENAI_API_KEY=

# JWT
JWT_SECRET=GENERATE_SECRET
JWT_EXPIRE_MINUTES=1440

# Docker Compose
COMPOSE_PROJECT_NAME=myapp